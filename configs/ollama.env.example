# Copy selected profile into local .env; do not commit credentials.
# CLI > process environment > env file > defaults.
INVOICE_BACKEND=ollama
INVOICE_OLLAMA_URL=http://127.0.0.1:11434
INVOICE_OLLAMA_MODEL=qwen3-vl:2b
INVOICE_OLLAMA_DEVICE=cpu
INVOICE_OLLAMA_TIMEOUT=600
INVOICE_OLLAMA_NUM_CTX=8192
INVOICE_OLLAMA_NUM_THREADS=
INVOICE_OLLAMA_KEEP_ALIVE=5m
INVOICE_INPUT_DIR=data/valid
INVOICE_OUTPUT_DIR=outputs/ollama-valid-v1
INVOICE_PROMPT_PATH=prompts/invoice.txt
INVOICE_MAX_EDGE=1600
INVOICE_MAX_NEW_TOKENS=4096
INVOICE_LIMIT=
INVOICE_DATABASE_URL=
INVOICE_POSTGRES_PASSWORD=
INVOICE_POSTGRES_PORT=5432
