# Copy selected profile into local .env; do not commit credentials.
# CLI > process environment > env file > defaults.
INVOICE_BACKEND=transformers
INVOICE_MODEL_ID=unsloth/Llama-3.2-11B-Vision-Instruct-bnb-4bit
INVOICE_MODEL_REVISION=main
INVOICE_MODEL_DIR=
INVOICE_DEVICE=cuda:0
INVOICE_OFFLINE=true
INVOICE_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
INVOICE_TORCH_VERSION=2.14.1
INVOICE_VISION_VERSION=0.29.1
INVOICE_INPUT_DIR=data/valid
INVOICE_OUTPUT_DIR=outputs/transformers-valid-v1
INVOICE_PROMPT_PATH=prompts/invoice.txt
INVOICE_MAX_EDGE=1600
INVOICE_MAX_NEW_TOKENS=4096
INVOICE_LIMIT=
INVOICE_DATABASE_URL=
INVOICE_POSTGRES_PASSWORD=
INVOICE_POSTGRES_PORT=5432
